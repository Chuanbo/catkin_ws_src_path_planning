<launch>

  <!--  ************** Gazebo Simulator *****************  -->
  <include file="$(find multi_robot_scenario)/launch/TD3_world.launch" />
  <include file="$(find multi_robot_scenario)/launch/pioneer3dx.gazebo.launch" />

  <!--  ******************* Maps ***********************  -->
  <node name="map_server" pkg="map_server" type="map_server" args="$(find multi_robot_scenario)/launch/TD3_map.yaml" output="screen">
    <param name="frame_id" value="map" />
  </node>

  <!--  **************** Visualisation ****************  -->
  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find multi_robot_scenario)/launch/pioneer3dx_map.rviz" />

  <arg name="robot_name" default="robot_0" />

  <!--  ************** Navigation ROBOT 0 *************  -->
  <node pkg="tf" type="static_transform_publisher" name="link_name" args="0 0 0 0 0 0 map odom 20" />

  <node pkg="dynamic_obstacle_detector" type="dynamic_obstacle_detector_node" name="dynamic_obstacle_detector" output="screen" >
        <param name="input_scan_topic" value="/p3dx/front_laser/scan" />
        <!-- <param name="odom_frame" value="robot_0/odom" /> -->
        <param name="odom_frame" value="map" />
        <param name="cluster_max_distance_points" value="0.6" />
        <!-- <param name="cluster_min_points" value="3" /> -->
        <!-- cluster_min_points 设置大一些的值，过滤掉距离机器人较远的障碍物 -->
        <param name="cluster_min_points" value="6" />
        <param name="cluster_max_points" value="40" />
        <param name="min_vel_tracked" value="0.1" />
        <param name="max_vel_tracked" value="1.3" />
        <param name="max_tracked_distance" value="0.55" />
        <param name="max_tracked_sec" value="0.8" />
  </node>

  <group ns="$(arg robot_name)">
    <remap from="/robot_120/base_scan" to="/p3dx/front_laser/scan" />
    <remap from="/robot_120/odom" to="/p3dx/odom" />
    <remap from="/robot_120/cmd_vel" to="/p3dx/cmd_vel" />
    <remap from="/robot_120/move_base_simple/goal" to="/move_base_simple/goal" />
    <node name="robot_nav_0" pkg="my_patrol_sim" type="new_robot_Astar_DWA.py" args="120" output="screen" />
  </group>

</launch>
